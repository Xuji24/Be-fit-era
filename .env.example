# Copy this file to .env and fill in real values.
# Never commit the real .env — it is already gitignored.

#SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


#SITE
# Public site origin, no trailing slash. Used for OAuth redirects, email
# links, and OG image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Some server actions/routes read this instead of NEXT_PUBLIC_SITE_URL —
# keep both in sync until they're consolidated to one var.
NEXT_PUBLIC_APP_URL=http://localhost:3000


#STRAVA
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
NEXT_PUBLIC_STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=choose-a-verify-token


#HCAPTCHA
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key


#EMAIL
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET_KEY=your-google-oauth-client-secret

# lib/email.ts sends via Nodemailer over Gmail SMTP. Requires 2-Step
# Verification on the sending account, then an App Password from
# Google Account → Security → App passwords (not the normal login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=Fitra <your-sender@gmail.com>

# Not read by app code — reserved in case this becomes Supabase Auth's
# custom SMTP provider later (Project Settings → Authentication → SMTP
# Settings), which needs its own verified sending domain either way.
RESEND_API_KEY=your-resend-api-key


#PUSH NOTIFICATIONS (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:you@example.com
# Lets the cron job trigger push sends without an admin session
INTERNAL_SERVICE_SECRET=choose-an-internal-secret


#PAYMONGO
# lib/paymongo.ts reads a single PAYMONGO_SECRET_KEY and switches to live
# mode automatically based on the sk_test_/sk_live_ prefix — do not declare
# this key twice in the same file, only the last declaration takes effect.
PAYMONGO_SECRET_KEY=sk_test_your-paymongo-secret-key
PAYMONGO_WEBHOOK_SECRET=whsec_your-paymongo-webhook-secret


#AI PROVIDER
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
AI_MODEL=                          # optional, provider default if unset
AI_MODEL_PRO=                      # optional, used for the paid coach tier
AI_PROVIDER_FALLBACK=gemini        # optional
GEMINI_API_KEY=your-gemini-api-key # required if fallback is gemini
OPENAI_API_KEY=your-openai-api-key # required if fallback is openai


#CRON
# Vercel Cron sends this as `Authorization: Bearer <value>` — vercel.json
# already schedules the jobs, but they 401 until this is set in the
# deployment's env vars.
CRON_SECRET=choose-a-cron-secret
